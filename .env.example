# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# --- Supabase: client-safe (exposed to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "publishable" key (sb_publishable_...) or legacy anon key. Safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase: server-only secrets (NEVER prefixed NEXT_PUBLIC, never sent to the browser) ---
# The "secret" key (sb_secret_...) or legacy service_role key. Used only in src/lib/supabase/admin.ts
# and scripts/. Needed from step 3 (user creation). Get it from Project Settings -> API.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database connection for migrations & pgTAP tests (server/CLI only) ---
# Local (Docker): postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted: copy the "Connection string" from Project Settings -> Database. URL-encode special
# characters in the password (@ becomes %40, etc.).
SUPABASE_DB_URL=

# --- App ---
NEXT_PUBLIC_APP_TZ=Asia/Colombo
